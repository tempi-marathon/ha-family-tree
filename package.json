{
  "name": "ha-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:cards": "vite build --watch --config vite.cards.config.ts",
    "dev:all": "npm run dev & npm run dev:cards",
    "build": "tsc --noEmit && vite build && vite build --config vite.cards.config.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
